# ---------------------------------------------------------------------------
# La Promessa, phase 1.
#
# Only the contact form needs anything here. The rest of the site is static
# content committed to the repo, so it builds and serves with none of this set.
# ---------------------------------------------------------------------------

# Resend. Same account as the other OvioPlus projects, separate API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The verified sender. lapromessa.it is NOT verified in Resend yet, so mail goes
# out from an ovioplus.ai address and the visitor's address is set as reply-to.
# Once the client's domain is verified, change this line and nothing else.
CONTACT_FROM_EMAIL="La Promessa <no-reply@ovioplus.ai>"

# Where the restaurant actually reads its mail.
CONTACT_TO_EMAIL=info@lapromessa.it

# Canonical URL, used for metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://lapromessa.vercel.app
